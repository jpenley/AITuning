@@ -0,0 +1,179 @@
+import { describe, expect, it } from "vitest";
+import {
+	McpElicitationScopes,
+	untilAborted,
+	validateElicitationRequest,
+	validateElicitationResponse,
+} from "../src/extensions/mcp/elicitation.ts";
+
+function form(properties: Record<string, unknown>, extra: Record<string, unknown> = {}) {
+	return { message: "Fill in", requestedSchema: { type: "object", properties, ...extra } };
+}
+
+function accepts(schema: unknown, value: unknown): boolean {
+	return validateElicitationRequest(form({ value: schema }, { required: ["value"] })).validateContent({ value });
+}
+
+describe("native form v1 validation", () => {
+	it("preserves explicit false, zero, empty strings and own __proto__ fields without applying defaults", () => {
+		const properties = JSON.parse(
+			'{"__proto__":{"type":"string"},"flag":{"type":"boolean","default":true},"count":{"type":"integer"},"text":{"type":"string"}}',
+		) as Record<string, unknown>;
+		const validated = validateElicitationRequest(form(properties));
+		const content = JSON.parse('{"__proto__":"own value","flag":false,"count":0,"text":""}') as Record<
+			string,
+			unknown
+		>;
+		const result = validateElicitationResponse({ action: "accept", content }, validated.validateContent);
+		expect(result.content).toEqual(content);
+		expect(Object.hasOwn(result.content ?? {}, "__proto__")).toBe(true);
+		expect(validateElicitationResponse({ action: "accept", content: {} }, validated.validateContent).content).toEqual(
+			{},
+		);
+	});
+
+	it.each([
+		{ type: "string", pattern: "(a+)+$" },
+		{ type: "string", $ref: "#/x" },
+		{ type: "string", minLength: -1 },
+		{ type: "string", minLength: 5, maxLength: 2 },
+		{ type: "string", format: "regex" },
+		{ type: "string", default: 0 },
+		{ type: "number", exclusiveMinimum: 1 },
+		{ type: "integer", minimum: 0.5 },
+		{ type: "integer", default: Number.MAX_SAFE_INTEGER + 1 },
+		{ type: "boolean", default: "false" },
+		{ type: "object", properties: {} },
+		{ type: "array", items: { type: "string" } },
+		{ type: "string", enum: ["x"], enumNames: [] },
+		{ type: "string", enum: ["x", "x"] },
+		{ type: "string", oneOf: [{ const: "x" }] },
+		{ type: "array", items: { type: "string", enum: ["x"] }, uniqueItems: true },
+	])("rejects unsupported assertions instead of weakening semantics (%#)", (schema) => {
+		expect(() => validateElicitationRequest(form({ value: schema }))).toThrow();
+	});
+
+	it("validates string codepoints, formats, numeric bounds and safe integers", () => {
+		expect(accepts({ type: "string", minLength: 1, maxLength: 1 }, "😀")).toBe(true);
+		expect(accepts({ type: "string", maxLength: 1 }, "😀😀")).toBe(false);
+		for (const [format, valid, invalid] of [
+			["email", "test@example.com", "not-email"],
+			["uri", "https://example.com/path", "relative/path"],
+			["date", "2024-02-29", "2025-02-29"],
+			["date-time", "2024-02-29T12:30:00Z", "2024-02-29T25:00:00Z"],
+		]) {
+			expect(accepts({ type: "string", format }, valid)).toBe(true);
+			expect(accepts({ type: "string", format }, invalid)).toBe(false);
+		}
+		expect(accepts({ type: "integer", minimum: 0, maximum: 2 }, 0)).toBe(true);
+		expect(accepts({ type: "integer" }, 0.5)).toBe(false);
+		expect(accepts({ type: "integer" }, Number.MAX_SAFE_INTEGER + 1)).toBe(false);
+		expect(accepts({ type: "number", minimum: -1, maximum: 1 }, 0.5)).toBe(true);
+		expect(accepts({ type: "number" }, Infinity)).toBe(false);
+	});
+
+	it("supports enums and titled choices including multi-select", () => {
+		for (const schema of [
+			{ type: "string", enum: ["", "a"], enumNames: ["Empty", "A"] },
+			{
+				type: "string",
+				oneOf: [
+					{ const: "", title: "Empty" },
+					{ const: "a", title: "A" },
+				],
+			},
+		]) {
+			expect(accepts(schema, "")).toBe(true);
+			expect(accepts(schema, "unknown")).toBe(false);
+		}
+		for (const items of [
+			{ type: "string", enum: ["a", "b"] },
+			{
+				type: "string",
+				anyOf: [
+					{ const: "a", title: "A" },
+					{ const: "b", title: "B" },
+				],
+			},
+		]) {
+			const schema = { type: "array", items, minItems: 1, maxItems: 2 };
+			expect(accepts(schema, ["a", "b"])).toBe(true);
+			expect(accepts(schema, [])).toBe(false);
+			expect(accepts(schema, ["c"])).toBe(false);
+		}
+	});
+
+	it("bounds fields, enum choices, JSON bytes, strings and required keys", () => {
+		expect(() =>
+			validateElicitationRequest(
+				form(Object.fromEntries(Array.from({ length: 33 }, (_, i) => [i, { type: "boolean" }]))),
+			),
+		).toThrow();
+		expect(() =>
+			validateElicitationRequest(
+				form({ x: { type: "string", enum: Array.from({ length: 129 }, (_, i) => String(i)) } }),
+			),
+		).toThrow();
+		expect(() => validateElicitationRequest({ ...form({}), message: "😀".repeat(8193) })).toThrow();
+		expect(() => validateElicitationRequest(form({ x: { type: "string" } }, { required: ["missing"] }))).toThrow();
+		expect(() => validateElicitationRequest(form({}, { additionalProperties: true }))).toThrow();
+		expect(() => validateElicitationRequest({ ...form({}), mode: "url" })).toThrow();
+		const many = Object.fromEntries(
+			Array.from({ length: 10 }, (_, i) => [i, { type: "string", description: "x".repeat(8192) }]),
+		);
+		expect(() => validateElicitationRequest(form(many))).toThrow();
+		const validated = validateElicitationRequest(form({ value: { type: "string" } }, { required: ["value"] }));
+		expect(validated.validateContent({})).toBe(false);
+		expect(validated.validateContent({ value: "x".repeat(8193) })).toBe(false);
+		expect(validated.validateContent({ value: "ok", unknown: false })).toBe(false);
+	});
+});
+
+describe("connection operation queue", () => {
+	it("recovers after failure and aborts a queued operation before dispatch", async () => {
+		const lifetime = new AbortController();
+		const queue = new McpElicitationScopes({ signal: lifetime.signal, available: () => true });
+		let finish: () => void = () => {
+			throw new Error("not started");
+		};
+		const first = queue.run(
+			lifetime.signal,
+			() =>
+				new Promise<void>((resolve) => {
+					finish = resolve;
+				}),
+		);
+		await new Promise((resolve) => setImmediate(resolve));
+		const cancel = new AbortController();
+		let called = false;
+		const second = queue.run(cancel.signal, async () => {
+			called = true;
+		});
+		cancel.abort();
+		await expect(second).rejects.toThrow();
+		expect(called).toBe(false);
+		finish();
+		await first;
+		await expect(
+			queue.run(lifetime.signal, async () => {
+				throw new Error("expected");
+			}),
+		).rejects.toThrow("expected");
+		expect(await queue.run(lifetime.signal, async () => 42)).toBe(42);
+	});
+
+	it("observes late provider rejection after cancellation", async () => {
+		const cancel = new AbortController();
+		let fail: (error: Error) => void = () => {
+			throw new Error("not started");
+		};
+		const work = new Promise<never>((_resolve, reject) => {
+			fail = reject;
+		});
+		const raced = untilAborted(work, cancel.signal);
+		cancel.abort();
+		await expect(raced).rejects.toThrow();
+		fail(new Error("late failure"));
+		await new Promise((resolve) => setImmediate(resolve));
+	});
+});

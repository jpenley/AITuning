+import type { AgentToolResult } from "@earendil-works/pi-agent-core";
+import { fauxAssistantMessage, fauxToolCall } from "@earendil-works/pi-ai";
+import { type JsonRpcRequest, LATEST_PROTOCOL_VERSION } from "@earendil-works/pi-mcp";
+import { createInMemoryTransportPair } from "@earendil-works/pi-mcp/testing";
+import { Type } from "typebox";
+import { expect, it, vi } from "vitest";
+import type { ExtensionAPI, ExtensionFactory, ToolExposure } from "../../src/core/extensions/types.ts";
+import { createMcpExtension } from "../../src/extensions/mcp/index.ts";
+import { createHarness, createTestUiContext } from "./harness.ts";
+
+const FORM = {
+	message: "Choose",
+	requestedSchema: { type: "object", properties: { yes: { type: "boolean" } }, required: ["yes"] },
+};
+const CANCEL = {
+	content: [],
+	details: undefined,
+	structuredContent: { action: "cancel" },
+} satisfies AgentToolResult<undefined>;
+
+// Break caught: native MCP omits form capability even when a callable UI provider is installed.
+it("advertises form elicitation when a callable provider and UI are available", async () => {
+	let capabilities: unknown;
+	const pair = createInMemoryTransportPair();
+	pair.server.onMessage((message) => {
+		if (!("id" in message) || !("method" in message)) return;
+		const request = message as JsonRpcRequest;
+		if (request.method === "initialize") capabilities = (request.params as { capabilities?: unknown })?.capabilities;
+		const result =
+			request.method === "initialize"
+				? {
+						protocolVersion: LATEST_PROTOCOL_VERSION,
+						capabilities: { tools: {} },
+						serverInfo: { name: "forms", version: "1" },
+					}
+				: { tools: [] };
+		void pair.server.send({ jsonrpc: "2.0", id: request.id, result });
+	});
+	await pair.server.start();
+	const harness = await createHarness({
+		initialActiveToolNames: [],
+		extensionFactories: [
+			(pi) =>
+				pi.registerTool({
+					name: "mcp_elicitation_v1",
+					label: "Form provider",
+					description: "Collect an MCP form.",
+					exposure: "codemode",
+					parameters: Type.Object({}),
+					async execute() {
+						return { content: [], details: undefined, structuredContent: { action: "cancel" } };
+					},
+				}),
+			createMcpExtension({
+				loadConfig: () => ({
+					servers: [{ name: "forms", config: { command: "unused", exposure: "direct" }, source: "test" }],
+					errors: [],
+				}),
+				createTransport: () => pair.client,
+			}),
+		],
+	});
+	try {
+		await harness.session.bindExtensions({ uiContext: createTestUiContext() });
+		await vi.waitFor(() => expect(capabilities).toBeDefined());
+		expect(capabilities).toMatchObject({ elicitation: { form: {} } });
+	} finally {
+		harness.cleanup();
+		await pair.server.close();
+	}
+});
+
+async function setup(
+	options: {
+		exposure?: ToolExposure | "absent";
+		headless?: boolean;
+		provider?: (signal: AbortSignal | undefined) => Promise<AgentToolResult<undefined>>;
+		forms?: unknown;
+		extra?: ExtensionFactory;
+		resourceForms?: boolean;
+		timeout?: number;
+		initializeForm?: boolean;
+		registered?: boolean;
+	} = {},
+) {
+	const pair = createInMemoryTransportPair();
+	const requests: JsonRpcRequest[] = [];
+	const replies = new Map<string | number, unknown>();
+	const pending = new Map<string, (reply: unknown) => void>();
+	let capabilities: unknown;
+	let api: ExtensionAPI | undefined;
+	let providerCalls = 0;
+	const providerInputs: unknown[] = [];
+	let providerSignal: AbortSignal | undefined;
+	let nextId = 0;
+	const incoming = (params: unknown = options.forms ?? FORM) => {
+		const id = `form-${++nextId}`;
+		const answer = new Promise<unknown>((resolve) => pending.set(id, resolve));
+		void pair.server.send({
+			jsonrpc: "2.0",
+			id,
+			method: "elicitation/create",
+			params: params as Record<string, unknown>,
+		});
+		return answer;
+	};
+	const finish = (id: string | number) => pair.server.send({ jsonrpc: "2.0", id, result: { content: [] } });
+	pair.server.onMessage((message) => {
+		if (!("id" in message)) return;
+		if (!("method" in message)) {
+			replies.set(message.id, message);
+			pending.get(String(message.id))?.(message);
+			pending.delete(String(message.id));
+			return;
+		}
+		const request = message as JsonRpcRequest;
+		requests.push(request);
+		if (request.method === "initialize") {
+			capabilities = (request.params as { capabilities?: unknown })?.capabilities;
+			const respond = () =>
+				pair.server.send({
+					jsonrpc: "2.0",
+					id: request.id,
+					result: {
+						protocolVersion: LATEST_PROTOCOL_VERSION,
+						capabilities: { tools: {}, resources: {} },
+						serverInfo: { name: "forms", version: "1" },
+					},
+				});
+			if (options.initializeForm) void incoming().then(respond);
+			else void respond();
+		} else if (request.method === "tools/list") {
+			void pair.server.send({
+				jsonrpc: "2.0",
+				id: request.id,
+				result: { tools: [{ name: "ask", inputSchema: { type: "object", properties: {} } }] },
+			});
+		} else if (request.method === "tools/call") {
+			void incoming().then(() => finish(request.id));
+		} else if (request.method === "resources/list") {
+			const respond = () => pair.server.send({ jsonrpc: "2.0", id: request.id, result: { resources: [] } });
+			if (options.resourceForms) void incoming().then(respond);
+			else void respond();
+		}
+	});
+	await pair.server.start();
+	const provider: ExtensionFactory = (pi) => {
+		api = pi;
+		if (options.registered) pi.registerMcpServer("forms", { command: "unused", exposure: "direct" });
+		if (options.exposure === "absent") return;
+		pi.registerTool({
+			name: "mcp_elicitation_v1",
+			label: "Forms",
+			description: "Trusted test form provider",
+			exposure: options.exposure ?? "codemode",
+			parameters: Type.Object({}, { additionalProperties: true }),
+			async execute(_id, _params, signal) {
+				providerCalls++;
+				providerInputs.push(_params);
+				providerSignal = signal;
+				return options.provider ? options.provider(signal) : CANCEL;
+			},
+		});
+	};
+	const harness = await createHarness({
+		initialActiveToolNames: [],
+		extensionFactories: [
+			provider,
+			...(options.extra ? [options.extra] : []),
+			createMcpExtension({
+				loadConfig: () => ({
+					servers: options.registered
+						? []
+						: [
+								{
+									name: "forms",

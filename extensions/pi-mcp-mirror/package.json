{
  "name": "pi-mcp-mirror",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Native-derived Pi session MCP with form elicitation and stock Codemode",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./index.ts",
    "./adapters": "./adapters.mjs"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "node scripts/run-stock-qualification.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@earendil-works/pi-mcp": "1.3.0",
    "pi-mcp-elicitation": "file:../pi-mcp-elicitation",
    "proper-lockfile": "4.1.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "22.19.19",
    "@types/proper-lockfile": "4.1.4"
  }
}

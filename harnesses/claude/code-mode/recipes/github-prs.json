{
  "name": "github-prs",
  "description": "List pull requests of a repository, one line each: #number author (draft): title. Leaves out bodies.",
  "tool": "mcp__plugin_github_github__list_pull_requests",
  "args": {
    "state": "open",
    "perPage": 100,
    "fields": [
      "number",
      "title",
      "user",
      "draft"
    ]
  },
  "params": {
    "owner": {
      "required": true
    },
    "repo": {
      "required": true
    },
    "state": {},
    "perPage": {}
  },
  "js": "(Array.isArray(r) ? r : []).map(p => '#' + p.number + ' ' + p.user?.login + (p.draft ? ' (draft)' : '') + ': ' + p.title).join('\\n')"
}

From 7fa7c13b1de3d0e5adcd8a99d5119e57a8234f9f Mon Sep 17 00:00:00 2001
From: Sam Ortiz <sam@ledgerly.test>
Date: Thu, 1 Oct 2026 09:30:00 +0000
Subject: [PATCH 1/3] feat(exports): build the invoice CSV

Ticket: .scratch/invoice-export/tickets/07-csv-export.md
---
 src/services/buildCsv.js |  9 +++++++++
 test/buildCsv.test.js    | 13 +++++++++++++
 2 files changed, 22 insertions(+)
 create mode 100644 src/services/buildCsv.js
 create mode 100644 test/buildCsv.test.js

diff --git a/src/services/buildCsv.js b/src/services/buildCsv.js
new file mode 100644
index 0000000..731ea2f
--- /dev/null
+++ b/src/services/buildCsv.js
@@ -0,0 +1,9 @@
+// Invoice rows to CSV for Excel: a header line, then one line per invoice, CRLF line ends.
+const HEADER = 'number,customer,total,issued';
+
+function buildCsv(rows) {
+  const lines = rows.map((r) => [r.number, r.customer, r.total.toFixed(2), r.issued].join(','));
+  return [HEADER, ...lines].join('\r\n');
+}
+
+module.exports = { buildCsv };
diff --git a/test/buildCsv.test.js b/test/buildCsv.test.js
new file mode 100644
index 0000000..b5fd6d8
--- /dev/null
+++ b/test/buildCsv.test.js
@@ -0,0 +1,13 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { buildCsv } = require('../src/services/buildCsv');
+
+const row = (over = {}) => ({ number: 'INV-1', customer: 'Northwind', total: 12.5, issued: '2026-09-01', ...over });
+
+test('writes a header and one CRLF line per invoice', () => {
+  assert.equal(buildCsv([row(), row({ number: 'INV-2' })]).split('\r\n').length, 3);
+});
+
+test('starts with the header', () => {
+  assert.ok(buildCsv([]).startsWith('number,customer,total,issued'));
+});
